# ---- Core ----
DATABASE_URL=postgresql+psycopg://seo:seo@localhost:5432/seo
REDIS_URL=redis://localhost:6379/0

# Auth / security
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:1420
API_V1_PREFIX=/api/v1

# App
APP_NAME=SEO Intelligence Platform
APP_ENV=development
LOG_LEVEL=INFO

# ---- Providers (platform-level; user creds stored encrypted in DB, never here) ----
# SERP_PROVIDER=dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# ---- Google OAuth (GSC) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gsc/oauth/callback

# ---- LLM (analysis layer only, never for raw metrics) ----
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=

# ---- Billing ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Storage / exports ----
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=seo-exports
# S3_REGION=us-east-1

# ---- Observability ----
# SENTRY_DSN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
