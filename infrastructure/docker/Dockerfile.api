FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/api
RUN pip install --no-cache-dir uvicorn
COPY apps/api/pyproject.toml ./
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pydantic pydantic-settings sqlalchemy alembic "psycopg[binary]" redis celery "python-jose[cryptography]" argon2-cffi python-multipart httpx slowapi email-validator
COPY apps/api/ ./
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
