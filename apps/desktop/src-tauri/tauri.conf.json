{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEO Intelligence",
  "version": "0.1.0",
  "identifier": "com.seo.intelligence",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace apps/web",
    "beforeBuildCommand": "npm run build --workspace apps/web"
  },
  "app": {
    "windows": [{ "title": "SEO Intelligence", "width": 1400, "height": 900 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 https://* ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
